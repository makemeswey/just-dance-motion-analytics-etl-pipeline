# RabbitMQ — must match the broker credentials in docker-compose.yaml
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=changeme

# Host-side defaults; inside compose the consumer overrides these to rabbitmq:5672
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# Elasticsearch. The compose cluster runs with security disabled, so leave
# ES_USERNAME/ES_PASSWORD blank unless you point at a secured cluster.
ES_HOST=http://localhost:9200
ES_USERNAME=
ES_PASSWORD=
